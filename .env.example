# Copy to .env and fill in from Supabase: Project Settings -> API.
# These two values are PUBLIC by design (they ship in the browser). Row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# NEVER put the service_role key or an AI provider key here. The AI key is a server-side secret:
#   supabase secrets set ANTHROPIC_API_KEY=...
